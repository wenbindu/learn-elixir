[Unit]
Description=BEAM Path tutorial site
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=beam-path
Group=beam-path
WorkingDirectory=/opt/beam-path
Environment=NODE_ENV=production
Environment=VINEXT_TRUST_PROXY=1
Environment=BEAM_PATH_HOST=127.0.0.1
Environment=BEAM_PATH_PORT=3000
ExecStart=/opt/beam-path/scripts/start-prod.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
